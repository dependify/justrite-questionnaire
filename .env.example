# Copy this file to .env and change the token.
# Generate a strong token with: openssl rand -hex 24
ADMIN_TOKEN=replace-with-a-long-random-token

# Optional: a separate password for the /admin dashboard.
# If unset, the dashboard password is ADMIN_TOKEN.
# ADMIN_PASSWORD=replace-with-a-long-admin-password

PORT=8000
DATA_DIR=/data
MAX_BODY_BYTES=2000000
RATE_LIMIT_PER_MIN=20
LOGIN_RATE_LIMIT_PER_MIN=10
